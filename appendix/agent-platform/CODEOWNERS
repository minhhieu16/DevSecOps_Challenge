# CODEOWNERS for papaya/agent-platform (guardrails as code)
# Implements: separation of duties (ADR-005), ISO 27001 A.8.4 / A.8.32.
# Combined with the ruleset on `main` of this repo (require code owner review,
# required_approving_review_count = 2, approval of the most recent push), no single
# person and no agent can change a guardrail alone.
# NOTE: listing two teams on one line means EITHER team satisfies code-owner review.
# "One approval from platform AND one from security" is enforced by the
# `require-two-teams` status check (a small workflow that reads the PR reviews via
# the GitHub API) on the paths marked below. Verify: GitHub's path-scoped
# required-reviewers ruleset rule, if available on the plan, can replace it.

# Default: platform team
*                               @papaya/platform

# Guardrails that change what agents/people can do: platform + security
# (both teams required via the require-two-teams check)
/managed-settings/              @papaya/platform @papaya/security
/managed-mcp/                   @papaya/platform @papaya/security
/.claude-plugin/                @papaya/platform @papaya/security
/marketplace/plugins/papaya-guardrails/ @papaya/platform @papaya/security
/policies/                      @papaya/platform @papaya/security
/detections/                    @papaya/platform @papaya/security
/.github/                       @papaya/platform @papaya/security

# Evidence sign-off: security owns the weekly review approval
/evidence/                      @papaya/security

# Skills that only shape conventions: platform is enough
/marketplace/plugins/papaya-conventions/ @papaya/platform
/marketplace/plugins/papaya-infra/       @papaya/platform
/marketplace/plugins/papaya-debug/       @papaya/platform
/marketplace/plugins/papaya-runbooks/    @papaya/platform
