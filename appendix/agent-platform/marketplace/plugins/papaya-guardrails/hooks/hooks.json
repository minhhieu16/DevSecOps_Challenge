{
  "description": "papaya-guardrails: deterministic PreToolUse guard (see hooks/guard.py)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
