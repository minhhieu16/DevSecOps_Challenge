{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AthenaWeeklyWorkgroupOnly",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:StopQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:GetWorkGroup",
        "athena:ListQueryExecutions",
        "athena:BatchGetQueryExecution"
      ],
      "Resource": "arn:aws:athena:ap-southeast-1:111122223333:workgroup/audit-weekly"
    },
    {
      "Sid": "GlueCatalogReadAuditDb",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetPartition",
        "glue:GetPartitions",
        "glue:BatchGetPartition"
      ],
      "Resource": [
        "arn:aws:glue:ap-southeast-1:111122223333:catalog",
        "arn:aws:glue:ap-southeast-1:111122223333:database/audit",
        "arn:aws:glue:ap-southeast-1:111122223333:table/audit/*"
      ]
    },
    {
      "Sid": "S3ReadAuditPrefixes",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::papaya-audit-logs/cloudtrail/*",
        "arn:aws:s3:::papaya-audit-logs/otel/claude-code/*",
        "arn:aws:s3:::papaya-audit-logs/github/*",
        "arn:aws:s3:::papaya-audit-logs/k0s/*",
        "arn:aws:s3:::papaya-audit-logs/athena-results/weekly/*",
        "arn:aws:s3:::papaya-audit-logs/evidence/weekly/*"
      ]
    },
    {
      "Sid": "S3ListAuditBucketPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::papaya-audit-logs",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "",
            "cloudtrail/*",
            "otel/claude-code/*",
            "github/*",
            "k0s/*",
            "athena-results/weekly/*",
            "evidence/weekly/*"
          ]
        }
      }
    },
    {
      "Sid": "S3WriteResultsAndEvidenceOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::papaya-audit-logs/athena-results/weekly/*",
        "arn:aws:s3:::papaya-audit-logs/evidence/weekly/*"
      ]
    },
    {
      "Sid": "KmsAuditKeyForReadAndWrite",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:ap-southeast-1:111122223333:key/<audit-logs-key-id>"
    },
    {
      "Sid": "DenyAnyDeleteOrPolicyChangeOnAuditBucket",
      "Effect": "Deny",
      "Action": [
        "s3:Delete*",
        "s3:PutBucket*",
        "s3:PutLifecycleConfiguration",
        "s3:PutObjectRetention",
        "s3:PutObjectLegalHold",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": [
        "arn:aws:s3:::papaya-audit-logs",
        "arn:aws:s3:::papaya-audit-logs/*"
      ]
    }
  ]
}
