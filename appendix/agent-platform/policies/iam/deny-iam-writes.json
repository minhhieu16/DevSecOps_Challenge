{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAllIamWrites",
      "Effect": "Deny",
      "Action": [
        "iam:Create*",
        "iam:Put*",
        "iam:Attach*",
        "iam:Update*",
        "iam:Delete*",
        "iam:Detach*",
        "iam:Add*",
        "iam:Remove*",
        "iam:Set*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:Upload*",
        "iam:Enable*",
        "iam:Deactivate*",
        "iam:Resync*",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOrganizationsAndSsoAdminWrites",
      "Effect": "Deny",
      "Action": [
        "organizations:Create*",
        "organizations:Update*",
        "organizations:Delete*",
        "organizations:Attach*",
        "organizations:Detach*",
        "organizations:Enable*",
        "organizations:Disable*",
        "organizations:Move*",
        "organizations:Invite*",
        "organizations:Leave*",
        "organizations:Put*",
        "organizations:Remove*",
        "organizations:Register*",
        "organizations:Deregister*",
        "organizations:Close*",
        "sso:Create*",
        "sso:Put*",
        "sso:Attach*",
        "sso:Detach*",
        "sso:Update*",
        "sso:Delete*",
        "sso:Provision*",
        "sso:Tag*",
        "sso:Untag*",
        "sso-directory:Create*",
        "sso-directory:Update*",
        "sso-directory:Delete*",
        "sso-directory:Add*",
        "sso-directory:Remove*",
        "sso-directory:Disable*",
        "sso-directory:Enable*",
        "identitystore:Create*",
        "identitystore:Update*",
        "identitystore:Delete*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyAuditAndSecurityServiceTamper",
      "Effect": "Deny",
      "Action": [
        "cloudtrail:DeleteTrail",
        "cloudtrail:StopLogging",
        "cloudtrail:UpdateTrail",
        "cloudtrail:PutEventSelectors",
        "cloudtrail:PutInsightSelectors",
        "cloudtrail:DeleteEventDataStore",
        "guardduty:DeleteDetector",
        "guardduty:DisassociateFromMasterAccount",
        "guardduty:UpdateDetector",
        "guardduty:StopMonitoringMembers",
        "config:DeleteConfigurationRecorder",
        "config:DeleteDeliveryChannel",
        "config:StopConfigurationRecorder",
        "events:DeleteRule",
        "events:DisableRule",
        "events:RemoveTargets",
        "events:PutRule",
        "events:PutTargets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyAuditBucketMutation",
      "Effect": "Deny",
      "Action": [
        "s3:Delete*",
        "s3:Put*",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": [
        "arn:aws:s3:::papaya-audit-logs",
        "arn:aws:s3:::papaya-audit-logs/*"
      ]
    }
  ]
}
