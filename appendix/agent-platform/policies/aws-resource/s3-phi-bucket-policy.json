{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonTls",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::papaya-prod-<service>-phi",
        "arn:aws:s3:::papaya-prod-<service>-phi/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "DenyUnlessProdVpcEndpointOrApprovedPrincipal",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::papaya-prod-<service>-phi",
        "arn:aws:s3:::papaya-prod-<service>-phi/*"
      ],
      "Condition": {
        "StringNotEquals": { "aws:SourceVpce": "vpce-0prod0000000000000" },
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::111122223333:role/pipeline-deploy-prod",
            "arn:aws:iam::111122223333:role/prod-<service>-runtime-*",
            "arn:aws:iam::111122223333:role/aws-reserved/sso.amazonaws.com/ap-southeast-1/AWSReservedSSO_prod-breakglass_*"
          ]
        }
      }
    }
  ]
}
